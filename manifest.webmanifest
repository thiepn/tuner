{
  "id": "./",
  "name": "TUNER — Instrument Tuner",
  "short_name": "TUNER",
  "description": "A precision multi-instrument tuner with Stage Mode, landscape/mobile layouts, strobe tuning, intonation tools, favorites and offline PWA support.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone"
  ],
  "background_color": "#f4f5ee",
  "theme_color": "#f4f5ee",
  "orientation": "any",
  "prefer_related_applications": false,
  "categories": [
    "music",
    "utilities"
  ],
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Tuner",
      "short_name": "Tuner",
      "description": "Open the pitch tuner",
      "url": "./?view=tuner&source=shortcut"
    },
    {
      "name": "Tunings",
      "short_name": "Tunings",
      "description": "Browse instruments and tunings",
      "url": "./?view=tunings&source=shortcut"
    },
    {
      "name": "Tools",
      "short_name": "Tools",
      "description": "Open guided tuning, reference tones and metronome",
      "url": "./?view=tools&source=shortcut"
    },
    {
      "name": "Stage",
      "short_name": "Stage",
      "description": "Open the full-screen stage tuner",
      "url": "./?view=stage&source=shortcut"
    }
  ]
}
